# Valores apenas para ambiente local. Troque antes de usar em qualquer outro ambiente.

# Postgres (container db)
POSTGRES_PASSWORD=postgres-local
APP_OWNER_PASSWORD=owner-local
APP_RUNTIME_PASSWORD=runtime-local
APP_WORKER_PASSWORD=worker-local
DB_PORT=5432

# Senha dos usuários de demonstração criados pelo seed
SEED_PASSWORD=Demo@2026

# Desenvolvimento fora do Docker (pnpm dev)
# A API usa o papel app_runtime; migrations e seed usam o papel app_owner.
DATABASE_URL=postgresql://app_runtime:runtime-local@localhost:5432/solicitacoes
MIGRATION_DATABASE_URL=postgresql://app_owner:owner-local@localhost:5432/solicitacoes
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Autenticação (API)
# Segredo dos access tokens (JWT HS256), com pelo menos 32 caracteres. Gere um aleatório fora do
# ambiente local, por exemplo: openssl rand -base64 48
JWT_SECRET=segredo-local-de-desenvolvimento-troque-em-producao
# Validade do access token (número seguido de s, m, h ou d)
ACCESS_TOKEN_TTL=15m
# Validade de cada refresh token, em dias (renovada a cada troca)
REFRESH_TOKEN_DIAS=7
# Janela em que um refresh token recém-trocado ainda é aceito (duas abas renovando juntas)
REFRESH_GRACA_SEGUNDOS=10

# Cookies de sessão (web): true só atrás de HTTPS
COOKIE_SECURE=false

# Integração com o sistema externo (worker da outbox + ext-mock)
# O worker usa o papel app_worker, que só lê e atualiza a tabela outbox_eventos.
WORKER_DATABASE_URL=postgresql://app_worker:worker-local@localhost:5432/solicitacoes
EXT_URL=http://localhost:4010
# Intervalo entre ciclos, eventos por ciclo e tempo máximo de cada envio (ms)
OUTBOX_INTERVALO_MS=2000
OUTBOX_LOTE=10
OUTBOX_TIMEOUT_MS=5000
# Backoff exponencial com jitter de ±20%: base × 2^(tentativas − 1), até o teto (ms).
# Valores curtos para a demonstração; em produção, algo como 30000 e 7200000.
OUTBOX_BACKOFF_BASE_MS=2000
OUTBOX_BACKOFF_MAX_MS=60000
# Tentativas automáticas antes de FALHOU (a API usa o mesmo valor no detalhe)
OUTBOX_MAX_TENTATIVAS=8
WORKER_HEARTBEAT_ARQUIVO=/tmp/worker-heartbeat
# ext-mock: porta e probabilidade (0 a 1) de responder 503
MOCK_PORTA=4010
MOCK_FAILURE_RATE=0.5
