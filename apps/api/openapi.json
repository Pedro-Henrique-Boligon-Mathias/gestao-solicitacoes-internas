{
  "components": {
    "schemas": {
      "ProblemDetails": {
        "description": "Erro no formato RFC 9457 (application/problem+json)",
        "properties": {
          "code": {
            "description": "Código estável para o front (ex.: NAO_ENCONTRADO)",
            "type": "string"
          },
          "detail": {
            "description": "Ausente em erros 5xx",
            "type": "string"
          },
          "errors": {
            "description": "Erros por campo (DADOS_INVALIDOS)",
            "items": {
              "properties": {
                "campo": {
                  "description": "Caminho do campo, com \".\" nos aninhados (ex.: item.quantidade)",
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                }
              },
              "required": [
                "campo",
                "mensagem"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "description": "Caminho da requisição",
            "type": "string"
          },
          "requestId": {
            "description": "Mesmo valor do header X-Request-Id",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code"
        ],
        "type": "object"
      },
      "RespostaProntidaoDto": {
        "properties": {
          "details": {
            "properties": {
              "database": {
                "properties": {
                  "status": {
                    "enum": [
                      "up",
                      "down"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              }
            },
            "required": [
              "database"
            ],
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "details"
        ],
        "type": "object"
      },
      "RespostaVivacidadeDto": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "API para registro, análise e acompanhamento de solicitações internas.",
    "title": "Gestão de Solicitações Internas",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "vivacidade",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaVivacidadeDto"
                }
              }
            },
            "description": "Processo de pé"
          }
        },
        "summary": "O processo está de pé (liveness)",
        "tags": [
          "saúde"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "prontidao",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaProntidaoDto"
                }
              }
            },
            "description": "Pronta para atender"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaProntidaoDto"
                }
              }
            },
            "description": "Algum componente está fora do ar"
          }
        },
        "summary": "A API consegue atender, com banco acessível (readiness)",
        "tags": [
          "saúde"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
