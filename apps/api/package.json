{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST da gestão de solicitações internas (NestJS + Prisma)",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "nest build && node dist/openapi/gerar-openapi.js"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "8.3.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.2.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "jest": {
    "rootDir": ".",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/modules/solicitacoes/domain/**/*.ts",
      "src/modules/integracoes/domain/**/*.ts",
      "!**/*.spec.ts"
    ],
    "coverageThreshold": {
      "./src/modules/solicitacoes/domain/": {
        "lines": 90,
        "branches": 90
      },
      "./src/modules/integracoes/domain/": {
        "lines": 90,
        "branches": 90
      }
    }
  }
}
